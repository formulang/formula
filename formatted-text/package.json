{
  "name": "@formulang/formatted-text",
  "version": "1.1.0",
  "description": "Opt-in functions that read HTML and markdown text for the Formulang formula language.",
  "keywords": [
    "formula",
    "expression-language",
    "dsl",
    "typescript",
    "markdown",
    "html",
    "plain-text"
  ],
  "homepage": "https://github.com/formulang/formula/tree/main/formatted-text#readme",
  "bugs": {
    "url": "https://github.com/formulang/formula/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formulang/formula.git",
    "directory": "formatted-text"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "default": "./dist/definitions.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prettier": "prettier --write . --ignore-path ../.prettierignore",
    "prettier:check": "prettier --check . --ignore-path ../.prettierignore",
    "test": "vitest run --config ../vitest.config.ts --passWithNoTests",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@formulang/definitions": "workspace:^"
  }
}
